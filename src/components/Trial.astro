---
// #aprobatsiia (concept 8.1 №3): one big figure, the 14-day strip (signature 2), 3 facts, CTA. Facts: W-F017.
import Icon from "./Icon.astro";
import { phones, telegram } from "../data/site";
const days = Array.from({ length: 14 }, (_, i) => i + 1);
---
<section id="aprobatsiia" class="trial section" aria-labelledby="trial-title">
  <div class="container trial__grid">
    <div class="trial__lead">
      <h2 id="trial-title" class="h2">Апробація у вашому відділенні</h2>
      <p class="trial__figure display" aria-label="від 10 до 14 днів безкоштовно">
        <span class="trial__num num" aria-hidden="true">10–14</span>
        <span class="trial__unit" aria-hidden="true">днів безкоштовно</span>
      </p>
    </div>

    <div class="trial__body">
      <figure class="strip" aria-label="Діаграма терміну апробації: від 10 до 14 днів">
        <ol class="strip__cells" data-fill>
          {days.map((d) => (
            <li class:list={["strip__cell", d <= 10 ? "is-base" : "is-extra"]} style={`--i:${d - 1}`}>
              <span class="strip__fill" aria-hidden="true"></span>
              <span class="strip__day num">{d}</span>
            </li>
          ))}
        </ol>
        <figcaption class="strip__cap small muted">Термін апробації: від 10 до 14 днів</figcaption>
      </figure>

      <ul class="trial__facts">
        <li><h3 class="trial__fact-title">Доставка й інсталяція</h3><p class="muted">Harwind організовує доставку та інсталяцію.</p></li>
        <li><h3 class="trial__fact-title">Клінічний спеціаліст</h3><p class="muted">Ендоскопія, наркозно-дихальне обладнання й реанімація, ультразвук.</p></li>
        <li><h3 class="trial__fact-title">Без оплати</h3><p class="muted">Апробацію не оплачуєте, рішення про покупку після тесту.</p></li>
      </ul>

      <div class="trial__actions">
        <a class="btn btn--primary" href={`tel:${phones.sales.tel}`}><Icon name="phone" />Запитати апробацію</a>
        <a class="link trial__tg" href={telegram} rel="noopener">або написати в Telegram</a>
      </div>
    </div>
  </div>
</section>

<style>
  .trial.section { padding-bottom: var(--space-8); }
  .trial__grid { display: grid; gap: var(--space-6); }
  .trial__lead { display: grid; gap: var(--space-5); align-content: start; }
  .trial__figure { display: grid; gap: var(--space-1); }
  .trial__num { font-size: clamp(5rem, 3rem + 9vw, 10.5rem); line-height: 0.9; color: var(--color-field); letter-spacing: -0.02em; }
  .trial__unit { font-size: var(--text-xl); line-height: 1; }
  .trial__body { display: grid; gap: var(--space-6); align-content: start; }

  .strip { margin: var(--space-0); display: grid; gap: var(--space-3); }
  .strip__cells { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: var(--space-1); }
  .strip__cell { position: relative; display: grid; align-items: end; height: 80px; padding: var(--space-1); border: var(--rule) solid var(--color-field); }
  .strip__fill { position: absolute; inset: 0; background: var(--color-field); transform-origin: left center; }
  .strip__cell.is-extra .strip__fill { display: none; }
  .strip__day { position: relative; font-size: var(--text-xs); line-height: 1; color: var(--color-field); }
  .strip__cell.is-base .strip__day { color: var(--color-on-field); }
  /* Effect 3: cells 1–10 fill left to right once in view. Without JS and with reduced motion they are filled. */
  :global(.js) .strip__cells.is-armed:not(.is-in) .strip__fill { transform: scaleX(0); }
  :global(.js) .strip__cells.is-armed:not(.is-in) .is-base .strip__day { color: var(--color-field); }
  .strip__cells.is-in .strip__fill { transition: transform var(--dur) var(--ease-out); transition-delay: calc(var(--i) * 30ms); }
  .strip__cells.is-in .strip__day { transition: color var(--dur-micro) var(--ease-out); transition-delay: calc(var(--i) * 30ms + 120ms); }

  .trial__facts { display: grid; gap: var(--space-5); }
  .trial__facts li { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: var(--rule) solid var(--color-rule); }
  .trial__fact-title { font-size: var(--text-base); font-weight: var(--weight-semibold); line-height: 1.3; }
  .trial__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .trial__tg { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: var(--weight-semibold); }

  @media (max-width: 767px) {
    .strip__cell { height: 64px; padding: var(--space-0) var(--space-0) var(--space-1); justify-items: center; }
    .strip__cell:not(:first-child):not(:nth-child(10)):not(:last-child) .strip__day { visibility: hidden; }
    .trial__actions .btn { width: 100%; }
  }
  @media (min-width: 768px) {
    .trial__facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .trial__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .trial__lead { grid-column: 1 / span 5; }
    .trial__body { grid-column: 7 / span 6; padding-top: var(--space-2); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .strip__cells.is-armed:not(.is-in) .strip__fill { transform: none; }
    :global(.js) .strip__cells.is-armed:not(.is-in) .is-base .strip__day { color: var(--color-on-field); }
  }
</style>
