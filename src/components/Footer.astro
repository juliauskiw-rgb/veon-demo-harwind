---
// Footer (concept 5 «Футер»): light, teal rule, directions, company pages (future), contacts per department, socials.
import FutureLink from "./FutureLink.astro";
import Logo from "./Logo.astro";
import { directions, phones, email, socials, NOTE } from "../data/site";
const company = ["Про компанію", "Новини та події", "Оплата та доставка", "Політика конфіденційності", "Фінансова звітність"];
const contacts = [phones.sales, phones.service, phones.charity, phones.office];
const year = new Date().getFullYear();
---
<footer class="ftr" data-rec="R-012">
  <div class="container">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a href="#top" aria-label="Harwind, на початок сторінки"><Logo /></a>
        <p class="small muted">Медичне обладнання для клінік і лікарень України.</p>
      </div>
      <nav class="ftr__col" aria-labelledby="f-dir">
        <h2 id="f-dir" class="ftr__h">Обладнання</h2>
        <ul>
          {directions.map((d) => <li><FutureLink note={NOTE}>{d.name}</FutureLink></li>)}
          <li><a class="link" href="#aprobatsiia">Обладнання для апробації</a></li>
        </ul>
      </nav>
      <nav class="ftr__col" aria-labelledby="f-co">
        <h2 id="f-co" class="ftr__h">Компанія</h2>
        <ul>
          {company.map((c) => <li><FutureLink note={NOTE}>{c}</FutureLink></li>)}
        </ul>
      </nav>
      <div class="ftr__col">
        <h2 class="ftr__h">Контакти</h2>
        <ul class="ftr__contacts">
          {contacts.map((p) => <li><span class="small muted">{p.label}</span><a class="link num" href={`tel:${p.tel}`}>{p.display}</a></li>)}
          <li><span class="small muted">E-mail</span><a class="link" href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </div>
      <div class="ftr__col">
        <h2 class="ftr__h">Соцмережі</h2>
        <ul>
          {socials.map((s) => <li><a class="link" href={s.href} rel="noopener">{s.name}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="ftr__base small muted">
      <p>© Harwind, {year}</p>
      <FutureLink note={NOTE}>English</FutureLink>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--color-bg); border-top: var(--rule-strong) solid var(--color-field); padding-block: var(--space-7) var(--space-5); }
  .ftr__grid { display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); }
  .ftr__brand { display: grid; gap: var(--space-3); align-content: start; }
  .ftr__brand p { max-width: 28ch; }
  .ftr__h { font-size: var(--text-base); font-weight: var(--weight-semibold); line-height: 1.3; margin-bottom: var(--space-3); }
  .ftr__col ul { display: grid; gap: var(--space-1); }
  .ftr__col li { min-height: var(--tap); display: flex; align-items: center; }
  .ftr__col :global(.future-link) { min-height: var(--tap); }
  .ftr__contacts li { display: grid; gap: var(--space-0); align-content: center; padding-block: var(--space-1); }
  .ftr__contacts a { display: inline-flex; align-items: center; min-height: 32px; justify-self: start; }
  .ftr__base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-4); margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--rule) solid var(--color-rule); }
  .ftr__base :global(.future-link) { min-height: var(--tap); }

  @media (min-width: 640px) {
    .ftr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .ftr__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6) var(--gutter); }
  }
  @media (min-width: 1280px) {
    .ftr__grid { grid-template-columns: 1fr 1.4fr 1.2fr 1.1fr 0.8fr; }
  }
  @media (max-width: 767px) {
    .ftr { padding-bottom: calc(var(--space-5) + var(--bar-h) + env(safe-area-inset-bottom)); }
  }
</style>
