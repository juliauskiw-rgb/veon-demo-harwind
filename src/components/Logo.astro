---
// Client's own wordmark (from the client): the 400×200 file has wide margins, so the box crops them.
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<span class:list={["logo", cls]}>
  <img src={`${import.meta.env.BASE_URL}images/client/logo.webp`} width="400" height="200" alt="harwind" decoding="async" />
</span>

<style>
  .logo { display: block; width: 132px; height: 34px; overflow: hidden; }
  .logo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  @media (max-width: 767px) { .logo { width: 116px; height: 30px; } }
</style>
